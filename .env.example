# Optional: used for US end-of-day prices.
ALPHA_VANTAGE_API_KEY=

# personal (data/finance.db) or demo (data/demo.db)
APP_MODE=personal

# Cloud deployment only. Leave blank for local mode without login.
FINANCE_DB_URL=
FINANCE_APP_PASSWORD=
FINANCE_AUTH_SECRET=
FINANCE_AUTOMATION_TOKEN=
FINANCE_ALLOWED_ORIGINS=

# Netlify Scheduled Function only. Point this to the deployed Render backend.
FINANCE_AUTOMATION_URL=
