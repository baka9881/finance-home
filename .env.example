# Optional: used for US end-of-day prices.
ALPHA_VANTAGE_API_KEY=

# personal (data/finance.db) or demo (data/demo.db)
APP_MODE=personal

# Cloud deployment only. Leave blank for local mode without login.
FINANCE_DB_URL=
FINANCE_APP_PASSWORD=
FINANCE_AUTH_SECRET=
FINANCE_AUTOMATION_TOKEN=
FINANCE_ALLOWED_ORIGINS=
FINANCE_CREDENTIAL_SECRET=

# Gmail credit-card statement sync (OAuth 2.0, Gmail read-only scope).
FINANCE_GOOGLE_CLIENT_ID=
FINANCE_GOOGLE_CLIENT_SECRET=
# Local: http://127.0.0.1:8000/api/email/gmail/callback
# Cloud: https://YOUR-RENDER-HOST/api/email/gmail/callback
FINANCE_GOOGLE_REDIRECT_URI=
# Local: http://127.0.0.1:8000  Cloud: https://YOUR-NETLIFY-HOST
FINANCE_FRONTEND_URL=

# Netlify Scheduled Function only. Point this to the deployed Render backend.
FINANCE_AUTOMATION_URL=
